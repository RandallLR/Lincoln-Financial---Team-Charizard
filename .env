# ── Lincoln Financial Employee Portal — Environment Variables ──
#
# Copy this file to .env.local and fill in real values.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# Set to "true" to use the in-memory mock API (auto-enabled in dev)
VITE_USE_MOCK_API=true

# Base URL for the real Dental API backend
# (Vite proxies /api/* to this in development — see vite.config.js)
VITE_API_BASE_URL=/api/dental

# App metadata
VITE_APP_NAME=Lincoln Financial Employee Portal
VITE_APP_VERSION=1.0.0
