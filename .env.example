# ── Lincoln Financial Employee Portal — Environment Variables ──
#
# Copy this file to .env and fill in real values.
# .env is gitignored — this file is the safe-to-commit template.
#
# Variables prefixed with VITE_ are exposed to the browser bundle.
# There are NO secret API keys — Ollama runs fully locally.

# ── Dental API ─────────────────────────────────────────────
# Set to "true" to use the in-memory mock API (auto-enabled in dev)
VITE_USE_MOCK_API=true

# Base URL for the real Dental API backend
VITE_API_BASE_URL=/api/dental

# ── AI Dental Chat (Ollama) ────────────────────────────────
# Set to "false" to enable the live Ollama LLM.
# Requires Ollama running locally: ollama serve
# The Vite dev server proxies /api/ollama → http://localhost:11434
# No API key needed — fully local and free.
VITE_USE_MOCK_AI=true

# Ollama model to use. Pull it first: ollama pull phi3
# Recommended: phi3 (fast, 3.8B), llama3, mistral
VITE_OLLAMA_MODEL=phi3

# ── App metadata ───────────────────────────────────────────
VITE_APP_NAME=Lincoln Financial Employee Portal
VITE_APP_VERSION=1.0.0
